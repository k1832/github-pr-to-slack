{
  "manifest_version": 3,
  "name": "Copy PR Link (Rich Text)",
  "version": "1.4.0",
  "description": "Press Cmd+K (Mac) / Ctrl+K (Windows, Linux) on a GitHub PR page to copy its title and URL as a rich-text hyperlink, ready to paste into Slack without an unfurl preview.",
  "permissions": ["storage", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Copy PR Link",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
